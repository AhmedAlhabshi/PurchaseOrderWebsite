# ---------------------------------------------------------------------------
# Purchase Orders — environment variables
# Copy this file to ".env" and fill in the values.
# On Vercel, add these same variables in Project → Settings → Environment Variables.
# ---------------------------------------------------------------------------

# Database (Neon Postgres).
# From your Neon project, copy BOTH connection strings:
#  - DATABASE_URL  = the POOLED connection string (host contains "-pooler")
#  - DIRECT_URL    = the DIRECT connection string (used for migrations)
# Both must end with ?sslmode=require
DATABASE_URL="postgresql://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/DB?sslmode=require"
DIRECT_URL="postgresql://USER:PASSWORD@HOST.REGION.aws.neon.tech/DB?sslmode=require"

# ---------------------------------------------------------------------------
# Access gate (shared password — NOT user accounts).
# When APP_PASSWORD is set, everyone must enter it to open the app.
# Leave APP_PASSWORD empty to disable the gate (e.g. local development).
# ---------------------------------------------------------------------------
APP_USER="team"
APP_PASSWORD=""

# ---------------------------------------------------------------------------
# Email (SMTP). Leave empty to run in preview mode (nothing is actually sent).
# Fill in to send real emails (Gmail app password, Outlook, SendGrid, etc.).
# ---------------------------------------------------------------------------
SMTP_HOST=""
SMTP_PORT="587"
SMTP_SECURE="false"          # "true" for port 465, "false" for 587/25
SMTP_USER=""
SMTP_PASSWORD=""
MAIL_FROM="Purchasing <purchasing@example.com>"
